{
  "manifest_version": 3,
  "name": "Test Privacy Risk Extension",
  "version": "1.0",
  "description": "Extension used to test Browser Extension Privacy Analyzer",

  "permissions": [
    "tabs","cookies"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Privacy Analyzer Test"
  }
}